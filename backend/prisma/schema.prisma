generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; these fields hold string
// constants enforced in application code — see src/constants.ts.
// Role: "SUPER_ADMIN" | "ENTREPRENEUR" | "COLLABORATOR"
// PhaseStatus: "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED" | "BLOCKED"
// MediaType: "IMAGE" | "VIDEO" | "DOCUMENT"
// Trade: "ARCHITECT" | "CONSTRUCTION_ENGINEER" | "INTERIOR_DESIGNER" | "ELECTRICIAN"
//        | "PLUMBER" | "COMMUNICATIONS_TECHNICIAN" | "MAIN_CONTRACTOR"
// ProjectStage: "SKELETON" | "ELECTRICITY" | "PLUMBING" | "PLASTER" | "FLOORING"
//               | "ALUMINUM" | "FENCES"

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  trade        String? // e.g. "ELECTRICIAN", null for SUPER_ADMIN/ENTREPRENEUR — see Trade in src/constants.ts
  createdAt    DateTime @default(now())
  createdById  Int? // who created this user (SUPER_ADMIN creates ENTREPRENEURs, ENTREPRENEUR creates COLLABORATORs); null for bootstrap/seed-created users

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  assignments  PhaseAssignment[]
  updates      Update[]
  participants ProjectParticipant[]
  projects     Project[] // projects owned by this user when role = ENTREPRENEUR

  @@index([createdById])
}

model Project {
  id             Int      @id @default(autoincrement())
  name           String
  location       String
  overallStatus  String   @default("NOT_STARTED")
  owners         String? // free text, project owners/clients
  totalBudget    Float?
  currentStage   String? // ProjectStage vocabulary — distinct from overallStatus, see src/constants.ts
  createdAt      DateTime @default(now())
  entrepreneurId Int // owning ENTREPRENEUR; required — every project has exactly one paying-client owner, see team-lead contract

  entrepreneur      User                 @relation(fields: [entrepreneurId], references: [id], onDelete: Restrict)
  units             Unit[]
  financialRecords  FinancialRecord[]
  participants      ProjectParticipant[]
  updates           Update[]

  @@index([entrepreneurId])
}

model Unit {
  id         Int      @id @default(autoincrement())
  projectId  Int
  identifier String // e.g. "House A"
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phases  Phase[]

  @@index([projectId])
}

model Phase {
  id        Int         @id @default(autoincrement())
  unitId    Int
  name      String // e.g. "Skeleton", "Plumbing", "Electricity"
  status    String   @default("NOT_STARTED")
  order     Int
  createdAt DateTime @default(now())

  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subPhases        SubPhase[]
  financialRecords FinancialRecord[]

  @@index([unitId])
}

model SubPhase {
  id        Int         @id @default(autoincrement())
  phaseId   Int
  name      String // e.g. "Underground", "Ground Floor", "Mamad"
  status    String   @default("NOT_STARTED")
  createdAt DateTime @default(now())

  phase       Phase             @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignments PhaseAssignment[]
  updates     Update[]

  @@index([phaseId])
}

model PhaseAssignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  subPhaseId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subPhase SubPhase @relation(fields: [subPhaseId], references: [id], onDelete: Cascade)

  @@unique([userId, subPhaseId])
  @@index([subPhaseId])
}

model ProjectParticipant {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  trade     String // Trade vocabulary — one slot per trade per project, see src/constants.ts
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, trade])
  @@index([userId])
}

model Update {
  id          Int      @id @default(autoincrement())
  subPhaseId  Int? // exactly one of subPhaseId / projectId is set — enforced by route design, not a DB constraint (see team-lead contract)
  projectId   Int?
  userId      Int
  subject     String? // short title; optional, see team-lead contract for validation rule
  description String? // free-text body; was "messageText" — renamed for clarity now that subject exists alongside it
  mediaUrl    String? // local path under /uploads
  mediaType   String? // "IMAGE" | "VIDEO"
  timestamp   DateTime @default(now())

  subPhase SubPhase? @relation(fields: [subPhaseId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subPhaseId])
  @@index([projectId])
}

model FinancialRecord {
  id              Int      @id @default(autoincrement())
  projectId       Int
  phaseId         Int?
  amountPaid      Float    @default(0)
  receiptMediaUrl String? // local path under /uploads
  timestamp       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([phaseId])
}
