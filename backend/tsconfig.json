{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": [
    "src/worker.ts",
    "src/worker-env.ts",
    "src/db/client.ts",
    "src/db/seed.ts",
    "src/middleware-worker",
    "src/routes-worker",
    "src/utils-worker"
  ]
}
