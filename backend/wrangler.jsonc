/**
 * Cloudflare Workers config for the Hono POC entry point (src/worker.ts).
 * This is separate from and does not affect the existing Express app
 * (src/app.ts / src/index.ts), which keeps running via `npm run dev`.
 *
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafteach-habayit-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  // otplib (TOTP) and the AES-GCM secret encryption in utils-worker/totpCrypto.ts
  // use node:crypto.
  "compatibility_flags": ["nodejs_compat"],

  // The built frontend (frontend/dist) is served by this same Worker so the
  // SPA's relative /api and /uploads calls stay same-origin, as with the Vite
  // proxy in local dev. Unmatched paths fall back to index.html for client
  // routing.
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mafteach-habayit-db",
      "database_id": "9a73c975-d00a-438e-9b44-23dc5a354ffd"
    }
  ],

  // Uploaded files. KV instead of R2 because R2 can't be enabled on this
  // account without a payment method; KV's free tier needs none. See
  // utils-worker/upload.ts for the chunking around KV's 25 MiB value limit.
  "kv_namespaces": [
    {
      "binding": "UPLOADS_KV",
      "id": "8637a7f5043c4330ba4681fcdf57cba8"
    }
  ],

  // Top level above = production. `--env dev` deploys the same code as the
  // separate Worker "mafteach-habayit-api-dev" with its own D1/KV, where QA
  // runs before anything is promoted to production. Bindings aren't
  // inherited by environments, so they're repeated here.
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mafteach-habayit-db-dev",
          "database_id": "cd7e5e1a-cd61-4413-ad7b-4a36cbb90800"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "UPLOADS_KV",
          "id": "73d28cdad3b54a9b91653af66ff5b9b8"
        }
      ]
    }
  }
}
